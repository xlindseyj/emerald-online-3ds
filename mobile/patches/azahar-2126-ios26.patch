 #include <list>
 #include <numeric>
 #include <vector>
@@ -489,6 +490,77 @@ void retro_reset() {
     emu_instance->game_loaded = do_load_game();
 }
 
+#if defined(IOS) && defined(__aarch64__)
+namespace {
+
+// 0 = legacy debugger JIT, 1 = universal protocol is preparing regions,
+// 2 = universal protocol completed and the debugger detached.
+std::atomic<int> jit26_protocol_state{0};
+std::atomic<unsigned> jit26_prepared_regions{0};
+
+__attribute__((noinline, optnone, naked)) void* JIT26PrepareRegion(void* address,
+                                                                  size_t length) {
+    __asm__("mov x16, #1\n"
+            "brk #0xf00d\n"
+            "ret\n");
+}
+
+__attribute__((noinline, optnone, naked)) void JIT26Detach() {
+    __asm__("mov x16, #0\n"
+            "brk #0xf00d\n"
+            "ret\n");
+}
+
+} // namespace
+
+extern "C" bool azahar_jit26_begin_preparation() {
+    jit26_prepared_regions.store(0, std::memory_order_release);
+    jit26_protocol_state.store(1, std::memory_order_release);
+    return true;
+}
+
+extern "C" int azahar_jit26_protocol_state() {
+    return jit26_protocol_state.load(std::memory_order_acquire);
+}
+
+extern "C" void* azahar_jit26_prepare_region(void* address, size_t length) {
+    if (jit26_protocol_state.load(std::memory_order_acquire) != 1 || address == nullptr ||
+        length == 0) {
+        return nullptr;
+    }
+    void* prepared = JIT26PrepareRegion(address, length);
+    if (prepared == address)
+        jit26_prepared_regions.fetch_add(1, std::memory_order_acq_rel);
+    return prepared;
+}
+
+extern "C" bool azahar_jit26_finish_preparation() {
+    if (jit26_protocol_state.load(std::memory_order_acquire) != 1) {
+        return false;
+    }
+    const bool prepared = jit26_prepared_regions.load(std::memory_order_acquire) > 0;
+    JIT26Detach();
+    jit26_protocol_state.store(2, std::memory_order_release);
+    return prepared;
+}
+#else
+extern "C" bool azahar_jit26_begin_preparation() {
+    return false;
+}
+
+extern "C" int azahar_jit26_protocol_state() {
+    return 0;
+}
+
+extern "C" void* azahar_jit26_prepare_region(void*, size_t) {
+    return nullptr;
+}
+
+extern "C" bool azahar_jit26_finish_preparation() {
+    return false;
+}
+#endif
+
